# Copy this file to '.env' and fill in your actual values.
# Do NOT commit the '.env' file to version control.

# JWT Secret Key (Should be at least 256 bits / 32 bytes for HS256). Required.
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_bytes_long

# HyperDX ingestion key for the local self-hosted clickstack container (see docker-compose.yml).
# Optional: leave empty to skip the OTLP authorization header entirely.
HYPERDX_API_KEY=
